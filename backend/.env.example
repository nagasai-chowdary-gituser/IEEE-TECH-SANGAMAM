APP_ENV=development
DEMO_API_TOKEN=change-me-local-demo-token
DATABASE_URL=sqlite:///./docuverify.db
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=INFO
TESSERACT_CMD=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Sandbox.co.in PAN API — API key and API secret from the Sandbox dashboard.
PAN_API_KEY=
PAN_API_SECRET=
# test = https://test-api.sandbox.co.in   live = https://api.sandbox.co.in
PAN_SANDBOX_ENV=test
# GSTIN Check (https://gstincheck.co.in) — paste the single API key only.
GST_IN_CHECK=
# Google OAuth (server-side only — never put the secret in the frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=change-me-auth-secret
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=user123
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123

# OpenAI-powered endpoint protection (server-side only)
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_DAILY=200
AI_RATE_LIMIT_IP_PER_MINUTE=30
AI_ABUSE_SPIKE_PER_MINUTE=25
AI_ABUSE_FAIL_STREAK=8
AI_ABUSE_TOKEN_HOUR=80000
AI_ABUSE_BLOCK_MINUTES=30
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_USD_PER_1K_INPUT=0.00015
AI_USD_PER_1K_OUTPUT=0.0006

